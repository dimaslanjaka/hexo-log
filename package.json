{
  "name": "hexo-log",
  "version": "4.1.0",
  "description": "Logger for Hexo",
  "type": "module",
  "main": "dist/cjs/log.js",
  "module": "dist/esm/log.js",
  "types": "dist/esm/log.d.ts",
  "exports": {
    ".": {
      "import": "./dist/log.js",
      "require": "./dist/log.cjs",
      "types": "./dist/log.d.ts"
    },
    "./dist/log": {
      "import": "./dist/log.js",
      "require": "./dist/log.cjs",
      "types": "./dist/log.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublish": "npm run clean && npm run build",
    "build": "node build.js && node scripts/build_exports.mjs",
    "clean": "npx -y rimraf dist tmp",
    "eslint": "eslint .",
    "test": "mocha --loader=ts-node/esm test/*.spec.ts",
    "test-cov": "nyc --reporter=lcovonly npm test",
    "lint": "eslint test lib",
    "lint-fix": "npm run lint -- --fix"
  },
  "files": [
    "dist/**"
  ],
  "repository": "hexojs/hexo-log",
  "homepage": "https://hexo.io/",
  "keywords": [
    "website",
    "blog",
    "cms",
    "framework",
    "hexo"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.7.4",
    "@types/rewire": "^2.5.30",
    "binary-collections": "^2.0.10",
    "chai": "^5.0.3",
    "eslint": "^8.56.0",
    "eslint-config-hexo": "^5.0.0",
    "mocha": "^10.0.0",
    "nyc": "^15.0.0",
    "rewire": "^6.0.0",
    "sinon": "^15.0.2",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
